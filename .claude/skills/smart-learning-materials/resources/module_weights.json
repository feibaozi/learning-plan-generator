{
  "_description": "模块权重与亲和度预设 — 定义 relevance_base + tag_affinity 评分体系",
  "_version": "3.0.0",
  "_usage": "Phase 2模块选择时：relevance_score = clamp(relevance_base + Σ_rank(tag_affinity[tag_rank] × decay^(rank-1)), 0, 1)，按|affinity|降序、最多top_n_cap个tag参与",
  "_selection_rules": {
    "mandatory_threshold": 0.80,
    "mandatory_desc": ">=0.80: 强制包含, 任何深度×广度组合都保留",
    "optional_threshold": 0.40,
    "optional_desc": "0.40-0.79: 可选, 按 relevance_score 降序取前 max_modules 个",
    "excluded_threshold": 0.40,
    "excluded_desc": "<0.40: 排除, 在当前主题下相关性不足以纳入"
  },

  "affinity_accumulation": {
    "method": "diminishing_returns",
    "description": "多个tag对同一模块的affinity按排名递减折扣累加，防止分数溢出使>1.0失去区分度。只对|affinity|>0的tag排序参与。",
    "decay_factor": 0.85,
    "top_n_cap": 6,
    "formula": "bonus = Σ_{rank=1..min(N, 6)} tag_affinity[tag_rank][module_id] × 0.85^(rank-1)",
    "ranking": "按 |tag_affinity[tag][module_id]| 降序排列，正负值均参与但需保持原符号",
    "example": "topic tags=['derivatives','pricing','quant-models','risk'] → quant_model affinities=[0.20, 0.22, 0.20, 0.08] → bonus=0.22 + 0.20×0.85 + 0.20×0.85² + 0.08×0.85³ = 0.22+0.17+0.1445+0.0491=0.584 而非原来的 0.70"
  },

