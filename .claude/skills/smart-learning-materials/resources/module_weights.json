    "_description": "模块的领域归属。非本领域的模块 relevance 自动归零。",
    "finance_only": ["quant_model", "regulation", "micro_structure", "cross_market", "crisis_review", "institution_diff"],
    "ai_tech_only": ["architecture", "compute_cost", "open_source", "benchmark", "ethics", "research_map"],
