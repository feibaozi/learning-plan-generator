    },
    "depth_params": {
      "概览": {
        "multiplier": 0.5,
        "description": "概览级别 — 每模块精简，强调概览与总结，减少深度推导"
      },
      "理解": {
        "multiplier": 1.0,
        "description": "理解级别 — 标准深度，平衡概念解释与原理推导"
      },
      "精通": {
        "multiplier": 1.6,
        "description": "精通级别 — 深度展开，完整的推导链、学术引用、前沿讨论"
      }
    },
    "word_count_base": {
