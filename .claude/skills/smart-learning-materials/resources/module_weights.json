  "depth_breadth_module_cap": {
    "_description": "深度×广度组合对 max_modules 数量的约束",
    "combinations": {
      "概览_核心": {"max_modules": 8, "content_depth": 0.5},
      "概览_标准": {"max_modules": 12, "content_depth": 0.5},
      "概览_全景": {"max_modules": 16, "content_depth": 0.5},
      "理解_核心": {"max_modules": 10, "content_depth": 1.0},
